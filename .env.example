# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง — .env ไม่ถูก commit เข้า git (ดู .gitignore)
# ห้าม copy ค่า SECRET_KEY ตัวอย่างด้านล่างไปใช้จริงเด็ดขาด ต้อง generate เองเสมอ

# สร้าง SECRET_KEY ใหม่ด้วยคำสั่งนี้ แล้ววางผลลัพธ์แทนค่าด้านล่าง:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-เปลี่ยนค่านี้ก่อนใช้งานจริงเสมอ

DEBUG=False
# *** สำคัญมาก — DEBUG=True เปิดตอนพัฒนา (เห็น error message ละเอียด) เท่านั้น ***
# ต้องเป็น False เสมอตอนใช้งานจริง (ให้ Admin ใช้จริง ไม่ใช่แค่ทดสอบ) — DEBUG=True จะโชว์ stack trace
# เต็มรูปแบบเวลา error เกิดขึ้น เผยรายละเอียดโค้ด/โครงสร้างฐานข้อมูล/path ไฟล์ในเครื่องให้คนอื่นเห็นได้
# ถ้าต้องการ debug ระหว่างพัฒนา ให้เปลี่ยนเป็น True เองชั่วคราว แล้วเปลี่ยนกลับเป็น False ก่อนใช้งานจริง
# เสมอ (ค่า default เปลี่ยนมาเป็น False ตั้งแต่ก่อนขึ้น V1 จริง — เดิมเคย default เป็น True ซึ่งเสี่ยงมาก
# ถ้า Admin ลืมเปลี่ยนก่อนใช้งานจริง)

# ปกติไม่ต้องตั้งพวกนี้เอง เพราะ .devcontainer/docker-compose.yml ตั้งให้อยู่แล้ว — ใช้ .env นี้เฉพาะ
# ตอนรันนอก devcontainer (เช่น บนโน้ตบุ๊กที่ไม่ได้ใช้ Codespaces) เท่านั้น
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gtd_poc
# DB_USER=app_role
# DB_PASSWORD=app_password
# DB_ADMIN_USER=postgres
# DB_ADMIN_PASSWORD=postgres

# LAN access — ให้เครื่องอื่นใน network เดียวกันเข้าได้
# 1. เพิ่ม IP จริงของเครื่องคุณด้านล่าง (หา IP ได้จาก ipconfig/ifconfig)
# 2. รัน server ด้วย: python manage.py runserver 0.0.0.0:8000
# CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.1.109:8000
